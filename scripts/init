#!/bin/sh
# initramfs /init for M0: bring up a USB CDC-ACM gadget and hand a shell to it.
#
# There is no UART on this phone, so this is the only console we have. Two
# rules, both learned the hard way:
#
#  1. PID 1 must never exit. If it does the kernel panics with "Attempted to
#     kill init" and reboot-loops, which is exactly as blind as a hang.
#  2. When there is no console, the phone itself has to report. It does that
#     with the only output it has - the time between reboots.
#
# Timing codes (watch the Xiaomi logo and count the seconds):
#
#   ~20 s   dwc3 never probed: /sys/class/udc is empty
#   ~40 s   UDC exists but the gadget did not bind / no /dev/ttyGS0
#   never   the gadget is up; the phone stays on because USB should now be
#           visible on the host
#
# A panic before /init looks different again: about 15 s, because panic=10 adds
# ten seconds to a normal boot.

export PATH=/bin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /sys/kernel/config
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t configfs none     /sys/kernel/config 2>/dev/null

G=/sys/kernel/config/usb_gadget/umi

gadget_create() {
	[ -d "$G" ] && return 0
	mkdir -p "$G" || return 1
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"

	mkdir -p "$G/strings/0x409"
	echo umi                > "$G/strings/0x409/serialnumber"
	echo umi-nethunter      > "$G/strings/0x409/manufacturer"
	echo "umi debug console" > "$G/strings/0x409/product"

	mkdir -p "$G/configs/c.1/strings/0x409"
	echo acm > "$G/configs/c.1/strings/0x409/configuration"

	mkdir -p "$G/functions/acm.usb0"
	ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
}

# Bind the gadget once a UDC exists. dwc3 may probe late, so this is retried.
gadget_bind() {
	gadget_create || return 1
	[ -n "$(cat "$G/UDC" 2>/dev/null)" ] && return 0
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	[ -n "$udc" ] || return 1
	echo "$udc" > "$G/UDC"
}

die_in() {
	# $1 = seconds from now. Reboot, and if the syscall is refused, use sysrq.
	echo "umi-m0: rebooting in $1 s (diagnostic code)" > /dev/kmsg 2>/dev/null
	sleep "$1"
	reboot -f
	echo b > /proc/sysrq-trigger
	sleep 10
}

n=0
udc_seen=0

while true; do
	n=$((n + 1))

	if gadget_bind && [ -c /dev/ttyGS0 ]; then
		echo "umi-m0: console up on $(cat "$G/UDC" 2>/dev/null)" \
			> /dev/kmsg 2>/dev/null
		# Child, not exec: if the host closes the port the shell exits and
		# the loop just spawns a new one.
		setsid sh -c '
			dmesg
			echo
			echo "=== umi mainline M0 shell ==="
			uname -a
			cat /proc/cmdline
			echo
			exec sh
		' </dev/ttyGS0 >/dev/ttyGS0 2>&1
		continue
	fi

	if [ -n "$(ls /sys/class/udc 2>/dev/null)" ]; then
		udc_seen=1
	fi

	if [ "$udc_seen" = 1 ]; then
		[ "$n" -ge 13 ] && die_in 1      # ~40 s from start
	else
		[ "$n" -ge 7 ] && die_in 1       # ~21 s from start
	fi

	sleep 3
done

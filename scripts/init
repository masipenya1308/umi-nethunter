#!/bin/sh
# initramfs /init for M0: bring up a USB CDC-ACM gadget and hand a shell to it.
#
# There is no UART on this phone, so this is the only console we have. Three
# rules, all learned the hard way:
#
#  1. PID 1 must never exit. If it does the kernel panics with "Attempted to
#     kill init" and reboot-loops, which is exactly as blind as a hang.
#  2. When there is no console, the phone itself has to report. It does that
#     with the only output it has - the time between reboots.
#  3. `echo <udc> > UDC` is not enough. usb_udc_connect_control() only calls
#     usb_gadget_connect() when udc->vbus is true, and nothing on this board
#     ever reports VBUS (no extcon, no role switch, no Type-C driver). The
#     gadget then binds, /dev/ttyGS0 exists, and the D+ pull-up is never
#     applied: UDC state stays "not attached" and the host sees nothing.
#     soft_connect is the direct lever that skips that check.
#
# Timing codes, counted from the moment the kernel takes over (the Xiaomi logo
# stays on screen for the whole time, so count until the phone goes dark):
#
#   ~8 s    dwc3 never probed: /sys/class/udc is empty
#   ~20 s   UDC exists but no /dev/ttyGS0 (gadget failed to bind)
#   ~35 s   ttyGS0 exists, UDC state still not attached (PHY/pull-up problem)
#   ~50 s   state "attached" but the host never configured us
#   never   the gadget is up: the phone stays on, USB should be visible
#
# A panic before /init looks different again: about 10 s plus the panic timeout.

export PATH=/bin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /sys/kernel/config
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t configfs none     /sys/kernel/config 2>/dev/null

G=/sys/kernel/config/usb_gadget/umi

gadget_create() {
	[ -d "$G" ] && return 0
	mkdir -p "$G" || return 1
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"

	mkdir -p "$G/strings/0x409"
	echo umi                > "$G/strings/0x409/serialnumber"
	echo umi-nethunter      > "$G/strings/0x409/manufacturer"
	echo "umi debug console" > "$G/strings/0x409/product"

	mkdir -p "$G/configs/c.1/strings/0x409"
	echo acm > "$G/configs/c.1/strings/0x409/configuration"

	mkdir -p "$G/functions/acm.usb0"
	ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"
}

udc_name() {
	ls /sys/class/udc 2>/dev/null | head -1
}

# Bind the gadget and then force the pull-up, which is what actually puts us on
# the bus. Returns 0 if the controller reports "configured".
gadget_up() {
	gadget_create || return 1
	udc=$(udc_name)
	[ -n "$udc" ] || return 1

	if [ "$(cat "$G/UDC" 2>/dev/null)" != "$udc" ]; then
		echo "$udc" > "$G/UDC" 2>/dev/null
	fi

	# The direct lever: usb_gadget_connect() without the vbus check.
	if [ -w "/sys/class/udc/$udc/soft_connect" ]; then
		echo connect > "/sys/class/udc/$udc/soft_connect" 2>/dev/null
	fi
	# Harmless if it does not exist; some kernels expose it.
	[ -w "/sys/class/udc/$udc/vbus" ] && echo 1 > "/sys/class/udc/$udc/vbus" 2>/dev/null

	case "$(cat "/sys/class/udc/$udc/state" 2>/dev/null)" in
		*configured*) return 0 ;;
	esac
	return 1
}

die_in() {
	# $1 = seconds from now. Reboot, and if the syscall is refused, use sysrq.
	echo "umi-m0: rebooting in $1 s (diagnostic code)" > /dev/kmsg 2>/dev/null
	sleep "$1"
	reboot -f
	echo b > /proc/sysrq-trigger
	sleep 10
}

# One bind attempt, one forced reconnect, then measure. dwc3 probes late on
# this board, so the UDC list can be empty on the very first pass.
i=0
while [ "$i" -lt 10 ]; do
	i=$((i + 1))
	gadget_up && break
	sleep 1
done

udc=$(udc_name)
state=$(cat "/sys/class/udc/$udc/state" 2>/dev/null)

# Everything we know, in one place, for whoever eventually reads a log.
{
	echo "umi-m0: udc=[$udc] state=[$state] tty=$([ -c /dev/ttyGS0 ] && echo yes || echo no)"
	dmesg | grep -i -E "dwc3|usb_1|hsphy|phy|udc|gadget" | tail -40
} > /dev/kmsg 2>/dev/null

if [ -c /dev/ttyGS0 ]; then
	echo "umi-m0: console up on $(udc_name)" > /dev/kmsg 2>/dev/null
	# Foreground on purpose: the shell owns the port, and PID 1 stays alive
	# waiting for it. If the host closes the port, the shell exits and a new
	# one is spawned.
	while true; do
		sh -c '
			dmesg
			echo
			echo "=== umi mainline M0 shell ==="
			uname -a
			cat /proc/cmdline
			echo
			exec sh
		' </dev/ttyGS0 >/dev/ttyGS0 2>&1
		sleep 1
	done
fi

if [ -z "$udc" ]; then
	die_in 8           # dwc3 never probed
elif [ ! -c /dev/ttyGS0 ]; then
	die_in 20          # no gadget
else
	case "$state" in
		*configured*|*addressed*) die_in 50 ;;
		*attached*)               die_in 50 ;;
		*)                        die_in 35 ;;
	esac
fi

# die_in always ends in a reboot, but never fall through into a panic.
while true; do sleep 60; done

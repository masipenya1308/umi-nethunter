#!/bin/sh
# umi M0 init.
#
# Goal of this build: one boot that cannot lie to us.
#
# Earlier inits encoded their diagnosis as a reboot delay, which was the only
# output channel available - but that made different failures look identical: a
# panic (panic=10) and a deliberate diagnostic reboot both gave a 15-20 s cycle,
# and a watchdog bite gave a 40-60 s one. This init never reboots and never
# exits, so "the phone is still on after three minutes" becomes a fact instead
# of an inference.
#
# It also stops depending on TCPM alone to hand dwc3 a role. With dr_mode "otg"
# + usb-role-switch, dwc3 refuses to connect until something says "device".
# TCPM is supposed to say it from the CC lines; if it is missing or does not see
# the cable, init forces the role through the usb_role class and pokes
# soft_connect, so the pull-up is requested from both ends.

export PATH=/bin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /sys/kernel/config
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t configfs none     /sys/kernel/config 2>/dev/null

log() { echo "umi-m0: $*" > /dev/kmsg 2>/dev/null; }

# The bootloader arms the AP watchdog before jumping to the kernel and there is
# no rootfs here to pet it. CONFIG_QCOM_WDT=y plus
# WATCHDOG_HANDLE_BOOT_ENABLED=y should already keep it fed from the kernel, but
# if that path does not work the phone resets mid-investigation and every test
# becomes unreadable. Holding the device open and writing to it every couple of
# seconds is the belt to that suspenders.
if [ -c /dev/watchdog ]; then
	exec 9>/dev/watchdog 2>/dev/null && log "watchdog: held open"
fi

log "init reached, holding"

G=/sys/kernel/config/usb_gadget/umi

setup_gadget() {
	[ -d "$G/configs" ] && return 0
	mkdir -p "$G" || return 1
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"

	mkdir -p "$G/strings/0x409"
	echo umi                > "$G/strings/0x409/serialnumber"
	echo umi-nethunter      > "$G/strings/0x409/manufacturer"
	echo "umi debug console" > "$G/strings/0x409/product"

	mkdir -p "$G/configs/c.1/strings/0x409"
	echo acm > "$G/configs/c.1/strings/0x409/configuration"

	mkdir -p "$G/functions/acm.usb0"
	ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0" 2>/dev/null
}

n=0
shell_up=0
while true; do
	setup_gadget

	# 1. Role first: everything else waits on it in otg mode.
	for r in /sys/class/usb_role/*/role; do
		[ -w "$r" ] && echo device > "$r" 2>/dev/null
	done

	# 2. Bind the gadget, then ask for the pull-up directly.
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	if [ -n "$udc" ]; then
		[ "$(cat "$G/UDC" 2>/dev/null)" = "$udc" ] || echo "$udc" > "$G/UDC" 2>/dev/null
		[ -w "/sys/class/udc/$udc/soft_connect" ] && \
			echo connect > "/sys/class/udc/$udc/soft_connect" 2>/dev/null
	fi

	# 3. Console, if the host ever enumerates us.
	if [ "$shell_up" = 0 ] && [ -c /dev/ttyGS0 ]; then
		log "ttyGS0 present on $udc state=$(cat /sys/class/udc/$udc/state 2>/dev/null)"
		setsid sh -c '
			dmesg
			echo
			echo "=== umi mainline M0 shell ==="
			uname -a
			cat /proc/cmdline
			echo
			echo "udc: $(ls /sys/class/udc) state: $(cat /sys/class/udc/*/state 2>/dev/null)"
			echo
			exec sh
		' </dev/ttyGS0 >/dev/ttyGS0 2>&1 &
		shell_up=1
	fi

	# 4. Keep the watchdog fed.
	[ -c /dev/watchdog ] && echo 1 >&9 2>/dev/null

	n=$((n + 1))
	if [ $((n % 15)) = 0 ]; then
		log "holding: udc=[$udc] state=[$(cat /sys/class/udc/*/state 2>/dev/null)] ttyGS0=[$([ -c /dev/ttyGS0 ] && echo yes || echo no)] role=[$(cat /sys/class/usb_role/*/role 2>/dev/null)]"
	fi

	sleep 2
done

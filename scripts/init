#!/bin/sh
# initramfs /init for M0: bring up a USB CDC-ACM gadget and hand the shell to it.
# There is no UART on this phone, so this is the only way to see anything.

export PATH=/bin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t configfs none     /sys/kernel/config 2>/dev/null || true

G=/sys/kernel/config/usb_gadget/umi
mkdir -p "$G"
echo 0x1d6b > "$G/idVendor"
echo 0x0104 > "$G/idProduct"

mkdir -p "$G/strings/0x409"
echo umi           > "$G/strings/0x409/serialnumber"
echo umi-nethunter > "$G/strings/0x409/manufacturer"
echo "umi debug console" > "$G/strings/0x409/product"

mkdir -p "$G/configs/c.1/strings/0x409"
echo acm > "$G/configs/c.1/strings/0x409/configuration"

mkdir -p "$G/functions/acm.usb0"
ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"

udc=$(ls /sys/class/udc 2>/dev/null | head -1)
if [ -n "$udc" ]; then
	echo "$udc" > "$G/UDC"
else
	echo "umi-m0: no UDC found" > /dev/kmsg 2>/dev/null
fi

# Wait for the gadget tty to appear.
i=0
while [ ! -c /dev/ttyGS0 ] && [ "$i" -lt 100 ]; do
	sleep 0.2
	i=$((i + 1))
done

if [ -c /dev/ttyGS0 ]; then
	exec setsid sh -c '
		dmesg
		echo
		echo "=== umi mainline M0 shell ==="
		echo "uname: $(uname -a)"
		exec sh
	' </dev/ttyGS0 >/dev/ttyGS0 2>&1
fi

# Nothing to talk to: stay alive so the watchdog does not reboot us.
while true; do sleep 3600; done

// SPDX-License-Identifier: GPL-2.0-only
/*
 * Xiaomi Mi 10 (umi) - SM8250
 *
 * M0 bring-up tree: enough to boot a mainline kernel into an initramfs with a
 * USB CDC-ACM console, plus a simple-framebuffer on the bootloader's splash so
 * that early kernel messages are visible on the panel. No storage, no PMIC
 * regulators - everything the bootloader leaves powered stays powered.
 *
 * Derived from mainline sm8250.dtsi / sm8250-xiaomi-elish-common.dtsi and the
 * downstream LineageOS device tree for umi.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include "sm8250.dtsi"

/ {
	model = "Xiaomi Mi 10 (umi)";
	compatible = "xiaomi,umi", "qcom,sm8250";

	/*
	 * The bootloader matches boot.img's DT against these. Without them it
	 * refuses to boot and drops back to fastboot (observed).
	 * msm-id 356 / 0x10000 = SM8250 "kona", board-id 43 = umi
	 * (from the downstream tree and the stock dtbo).
	 */
	qcom,msm-id = <356 0x10000>;
	qcom,board-id = <43 0>;

	/*
	 * 2 GiB of the installed 6/8/12 GiB. M0 needs almost nothing, and this
	 * range is present on every umi variant.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};
};

/*
 * Where the bootloader leaves its splash. Reserved so the allocator does not
 * hand it out, but mapped, because a simple-framebuffer points at it.
 */
&{/reserved-memory} {
	cont_splash_mem: splash@9c000000 {
		reg = <0x0 0x9c000000 0x0 0x2300000>;
	};
};

&{/chosen} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	framebuffer@9c000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0x9c000000 0x0 0x2300000>;
		width = <1080>;
		height = <2340>;
		stride = <4320>;
		format = "a8r8g8b8";
	};
};

/*
 * USB1 in peripheral mode: this is the console. The bootloader has already set
 * up the PHY rails, so only the HS PHY is described (no QMP/USB3).
 */
&usb_1 {
	/* USB 2.0 only, as on elish: take the pipe clock from UTMI. */
	qcom,select-utmi-as-pipe-clk;
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
};

&usb_1_hsphy {
	status = "okay";
	vdda-pll-supply = <&vreg_usb_hs_pll>;
	vdda18-supply = <&vreg_usb_hs_1p8>;
	vdda33-supply = <&vreg_usb_hs_3p1>;
};

/*
 * phy-qcom-snps-femto-v2 requests all three supplies unconditionally
 * (devm_regulator_bulk_get), so they must exist in the tree even though the
 * bootloader already left the real PMIC LDOs on: PM8150 L5A (0.88 V),
 * L12A (1.8 V) and L2A (3.1 V). Fixed always-on stand-ins are enough for M0;
 * the real pm8150 regulators arrive with the M4 power work.
 */
/ {
	vreg_usb_hs_pll: regulator-usb-hs-pll {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_pll_0p88";
		regulator-min-microvolt = <880000>;
		regulator-max-microvolt = <880000>;
		regulator-always-on;
	};

	vreg_usb_hs_1p8: regulator-usb-hs-1p8 {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	vreg_usb_hs_3p1: regulator-usb-hs-3p1 {
		compatible = "regulator-fixed";
		regulator-name = "usb_hs_3p1";
		regulator-min-microvolt = <3100000>;
		regulator-max-microvolt = <3100000>;
		regulator-always-on;
	};
};

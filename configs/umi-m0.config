# M0 kernel fragment: boot to an initramfs with a USB CDC-ACM shell.
# Merged on top of `make defconfig` by the CI job.

# --- USB device mode (the only console we have) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y

# --- USB Type-C role detection ---
# The PM8150B Type-C block owns the CC/VBUS state machine on this board and is
# what tells dwc3 that a cable is in. Built in, not a module: there is no rootfs
# to load it from, and arm64 defconfig has all of this as =m. Without it the
# gadget binds, /dev/ttyGS0 appears, and the UDC never leaves "not attached".
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_EXTCON=y

# DRM has to go, and not because M0 has no display.
#
# drivers/usb/typec/tcpm/Kconfig says:
#     config TYPEC_QCOM_PMIC
#         depends on DRM || DRM=n
# so with arm64 defconfig's DRM=m the Type-C driver can be at most =m too.
# merge_config then quietly demoted our =y to =m and the build stayed green -
# the boot image shipped with no TCPM at all, exactly like t8. With DRM off the
# dependency is satisfied and the driver is built in.
#
# M0 wants no display anyway (the panel is a command-mode DSI AMOLED with no
# mainline driver), and leaving DRM=m would also drag every DRM driver in the
# defconfig up to =y the moment one of them selects it.
# CONFIG_DRM is not set
# CONFIG_DRM_MSM is not set

# --- platform plumbing ---
# defconfig does not enable all of this, and every missing piece makes a driver
# defer forever instead of failing loudly. In particular: without QCOM_PDC the
# dwc3 node cannot even translate its interrupts-extended, and without the SM8250
# interconnect the USB wrapper never probes.
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_LLCC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# The bootloader hands over with the AP watchdog possibly still armed. defconfig
# builds qcom-wdt as a module, and there is no rootfs to load modules from, so
# the watchdog would reset the phone every timeout: a reboot loop that looks
# exactly like a kernel panic.
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# Same reasoning for the console: built in, never a module.
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# --- text console on the panel ---
# The bootloader's splash surface at 0x9c000000 is still being scanned out and
# nothing in mainline touches MDSS, so it can be used as a plain framebuffer
# (see the chosen node in the DTS). fbcon then puts the kernel log on the
# phone's own screen - the log channel M0 has been missing all along.
#
# fbdev, not DRM: simpledrm would drag DRM back in, and DRM has to stay off so
# that TYPEC_QCOM_PMIC can be built in. FB_SIMPLE also refuses to build
# alongside DRM_SIMPLEDRM, which is fine here.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_LOGO=n

# --- crash log that survives a reset ---
# 4 MiB at 0xb0000000, described in the DTS. Without a console and without
# storage, pstore is the only place a log can outlive a reboot.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# --- keep the build fast ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-umi"

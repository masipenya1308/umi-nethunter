# M0 kernel fragment: boot to an initramfs with a USB CDC-ACM shell.
# Merged on top of `make defconfig` by the CI job.

# --- USB device mode (the only console we have) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y

# --- platform plumbing ---
# defconfig does not enable all of this, and every missing piece makes a driver
# defer forever instead of failing loudly. In particular: without QCOM_PDC the
# dwc3 node cannot even translate its interrupts-extended, and without the SM8250
# interconnect the USB wrapper never probes.
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_LLCC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# The bootloader hands over with the AP watchdog possibly still armed. defconfig
# builds qcom-wdt as a module, and there is no rootfs to load modules from, so
# the watchdog would reset the phone every timeout: a reboot loop that looks
# exactly like a kernel panic.
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# Same reasoning for the console: built in, never a module.
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# --- keep the build fast ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-umi"

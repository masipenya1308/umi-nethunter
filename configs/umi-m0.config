# M0 kernel fragment: boot to an initramfs with a USB CDC-ACM shell.
# Merged on top of `make defconfig` by the CI job.

# --- USB device mode (the only console we have) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y

# --- visible console (best effort) ---
# The bootloader leaves a splash in the cont_splash_region; a simple-framebuffer
# on top of it gives us panics on the panel even before the USB gadget exists.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_8x16=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- SoC basics needed before anything else comes up ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_LLCC=y

# --- keep the build fast ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-umi"
